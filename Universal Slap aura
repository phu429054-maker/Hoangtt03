local function getSlapTool()
    local Backpack = LocalPlayer:FindFirstChild("Backpack")
    local Character = LocalPlayer.Character
    
    if Character then
        for _, item in ipairs(Character:GetChildren()) do
            if item:IsA("Tool") and string.match(item.Name, "Slap") then
                return item
            end
        end
    end
    
    if Backpack then
        for _, item in ipairs(Backpack:GetChildren()) do
            if item:IsA("Tool") and string.match(item.Name, "Slap") then
                return item
            end
        end
    end
    
    return nil
end

RunService.Heartbeat:Connect(function()
    if _G.SlapAuraEnabled then
        local Character = LocalPlayer.Character
        local myRoot = Character and Character:FindFirstChild("HumanoidRootPart")
        local SlapTool = getSlapTool()
        local SlapEvent = SlapTool and SlapTool:FindFirstChild("Event")
        
        if myRoot and SlapEvent then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local enemyChar = player.Character
                    local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
                    local enemyHumanoid = enemyChar:FindFirstChildOfClass("Humanoid")
                    
                    if enemyRoot and enemyHumanoid and enemyHumanoid.Health > 0 then
                        local dX = math.abs(myRoot.Position.X - enemyRoot.Position.X)
                        local dY = math.abs(myRoot.Position.Y - enemyRoot.Position.Y)
                        local dZ = math.abs(myRoot.Position.Z - enemyRoot.Position.Z)
                        
                        if dX <= 15 and dY <= 15 and dZ <= 15 then
                            local randomX = math.random(-5, 5) + math.random()
                            local randomY = math.random(-5, 5) + math.random()
                            local randomZ = math.random(-5, 5) + math.random()
                            
                            local args = {
                                [1] = "slash",
                                [2] = enemyChar,
                                [3] = Vector3.new(randomX, randomY, randomZ)
                            }
                            pcall(function()
                                SlapEvent:FireServer(unpack(args))
                            end)
                        end
                    end
                end
            end
        end
    end
end)
