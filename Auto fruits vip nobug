local function joinMarines()
    pcall(function()
        if not LocalPlayer.Team then
            updateStatus("Đang chọn phe Hải Quân...")
            ReplicatedStorage.Remotes.CommF_:InvokeServer("SetTeam", "Marines")
        end
    end)
end

local function storeAllFruits()
    pcall(function()
        for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
            local eatRemote = item:FindFirstChild("EatRemote", true)
            if eatRemote and eatRemote.Parent then
                local originalName = eatRemote.Parent:GetAttribute("OriginalName")
                if originalName then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StoreFruit", originalName, item)
                end
            end
        end
        if LocalPlayer.Character then
            for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
                if item:IsA("Tool") then
                    local eatRemote = item:FindFirstChild("EatRemote", true)
                    if eatRemote and eatRemote.Parent then
                        local originalName = eatRemote.Parent:GetAttribute("OriginalName")
                        if originalName then
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("StoreFruit", originalName, item)
                        end
                    end
                end
            end
        end
    end)
end

local function hopServer()
    updateStatus("Đang tìm Server mới...")
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(ApiUrl))
    end)
    
    if success and result and result.data then
        local validServers = {}
        for _, server in ipairs(result.data) do
            if server.id and server.playing and server.playing < server.maxPlayers and server.id ~= game.JobId then
                table.insert(validServers, server.id)
            end
        end
        
        if #validServers > 0 then
            local randomJobId = validServers[math.random(1, #validServers)]
            local args = {
                [1] = "teleport",
                [2] = randomJobId
            }
            ReplicatedStorage:WaitForChild("__ServerBrowser"):InvokeServer(unpack(args))
        else
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    else
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end

local function checkAndGetFruit()
    updateStatus("Đang quét Trái Ác Quỷ...")
    local fruitFound = false
    local targetPart = nil

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Tool") and obj.Name:match("Fruit") then
            fruitFound = true
            targetPart = obj:FindFirstChild("Handle")
            break
        elseif obj:IsA("Model") and (obj.Name:match("Fruit") or obj:FindFirstChild("Handle")) then
            fruitFound = true
            targetPart = obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("Part") or obj:FindFirstChildOfClass("MeshPart")
            break
        end
    end

    if fruitFound and targetPart then
        updateStatus("Phát hiện Trái! Đang bay tới nhặt...")
        task.spawn(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 1, 0)
                task.wait(0.2)
                storeAllFruits()
            end
        end)
        updateStatus("Đang đợi 3 giây để nhặt...")
        task.wait(3)
    else
        updateStatus("Không có trái! Đợi 5 giây đổi Server...")
        task.wait(5)
    end

    hopServer()
end

